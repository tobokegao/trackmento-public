#!/bin/sh
# pushの前に、配る物（CSS / JS・分割フォント）がR2にあるかを確かめる。
# 上げ忘れたままpushすると、Renderのデプロイ後に本番で404になる（scripts/check.pyの頭）。
#
# 入れ方はpre-commitと同じ（git config core.hooksPath .githooks）。
# わざと通したいときは `git push --no-verify`。

PY=.venv/Scripts/python
[ -x "$PY" ] || PY=.venv/bin/python
[ -x "$PY" ] || PY=python3
PYTHONUTF8=1 exec "$PY" scripts/check.py --r2
