.env
.venv/
__pycache__/
*.pyc
outputs/*
!outputs/.gitkeep
grids/*
!grids/.gitkeep
cache.sqlite3*
uploads/*
!uploads/.gitkeep
shares/*
!shares/.gitkeep
dist/

# 紹介動画（promo/）: 依存・出力・録画・音源はリポジトリに入れない
*.mp3
promo/node_modules/
promo/out/
promo/public/recordings/
promo/public/final.png
promo/public/

# Cloudflare wrangler の作業ファイル
.wrangler/

# .env の控え（.env.bak-* など）も鍵を含むので入れない。.env.example だけ例外
.env.*
!.env.example
# 譜割りエディタの中身の控え（メモ書きが入るので公開リポジトリに入れない。src/plan.gen.ts は入れる）
promo/plan.json

# 切り出した CSS / JS（scripts/build_app.py → upload_app_r2.py）。
# **殻だけはコミットする**（サーバーが frontend/dist/index.html を読んで配るため）。
# CSS と JS は R2 に上げるので、リポジトリには入れない（毎回 385KB 増えるのを避ける）。
# 上の dist/ でディレクトリごと無視されているので、順に打ち消す
!frontend/dist/
frontend/dist/*
!frontend/dist/index.html
