# Discogs パーソナルトークン（任意。未設定ならソース選択肢から非表示）
# 取得: https://www.discogs.com/settings/developers → 「Generate new token」→ 下に貼ってサーバー再起動
DISCOGS_TOKEN=

# MusicBrainz は User-Agent 必須（連絡先を含めること）
MB_USER_AGENT=musicgrid-local/0.1 (your-email@example.com)

# 生成 PNG の URL に使うベース。LAN 内の IP を指定（スマホから開くため）
# auto にすると起動時に LAN IP を自動検出する。例: http://192.168.1.10:8000
PUBLIC_BASE_URL=auto

# outputs/ に残す世代数
OUTPUTS_KEEP=50

# ---- 公開運用（Render などにバックエンドを置くとき。ローカルでは未設定でよい）----
# PUBLIC_MODE=1                      # CORS を開き、グリッドをブラウザごとに分け、ディスクを自動で掃除
# CORS_ORIGINS=https://you.github.io # フロントのオリジン（カンマ区切り）
# FRONTEND_URL=https://you.github.io/musicgrid-local   # 共有ページの「TRACKMENTO で開く」の戻り先
# RATE_LIMIT=120                     # API の IP ごと 1 分あたり上限
