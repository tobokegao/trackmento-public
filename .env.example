# Discogsパーソナルトークン（任意。未設定ならソース選択肢から非表示）
# 取得: https://www.discogs.com/settings/developers → 「Generate new token」→ 下に貼ってサーバー再起動
DISCOGS_TOKEN=

# MusicBrainzはUser-Agent必須（連絡先を含めること）
MB_USER_AGENT=trackmento/0.1 (your-email@example.com)

# 生成PNGのURLに使うベース。LAN内のIPを指定（スマホから開くため）
# autoにすると起動時にLAN IPを自動検出する。例: http://192.168.1.10:8000
PUBLIC_BASE_URL=auto

# outputs/ に残す世代数
OUTPUTS_KEEP=50

# ---- 公開運用（Renderなどにバックエンドを置くとき。ローカルでは未設定でよい）----
# PUBLIC_MODE=1                      # CORSを開き、グリッドをブラウザごとに分け、ディスクを自動で掃除
# CORS_ORIGINS=https://you.github.io # フロントのオリジン（カンマ区切り）
# FRONTEND_URL=https://you.github.io/trackmento   # 共有ページの「TRACKMENTOで開く」の戻り先
# RATE_LIMIT=120                     # APIのIPごと1分あたり上限
# TRUST_PROXY=1                      # Renderなどプロキシの後ろにいるとき（CF-Connecting-IP、無ければX-Forwarded-Forの先頭をIPとみなす）
# ---- 共有PNGをCloudflare R2に置く（4つ揃うと有効。無ければshares/ に保存）----
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=trackmento-shares
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev   # バケットの公開URL（あればPNGを直接配信）
# MAX_CELLS=256                      # 公開時の1枚あたりのマス数上限（既定256 = 16×16。1辺は32まで）
# MAX_SIDE=2400                      # サーバー描画PNGの最大辺（公開時の既定2400、ローカル8000。ブラウザ描画は端末ごとに最大3200）
# SHARE_BUDGET_GB=9.5                # 共有ファイル（PNG+JSON）の合計上限。実バイト数で判定。R2無料枠10GBの手前
# SHARE_LIMIT_PER_IP_DAY=100         # 共有の回数上限（IPごと・1日）。公開時の既定100（携帯回線はIPを共有するので緩め）
# SHARE_LIMIT_PER_DAY=1500           # 共有の回数上限（サーバー全体・1日）。公開時の既定1500。容量の保護はSHARE_BUDGET_GB
# ITUNES_PROXY_URL=https://xxxx.workers.dev   # サーバー側iTunes検索の中継（Cloudflare Workers、scripts/cloudflare/itunes-proxy.js）。
#                                             # AppleがRenderのIPを遮断しているときに設定。無ければAppleを直接呼ぶ
# ITUNES_PROXY_TOKEN=                          # 中継側のTOKENと同じ値（任意。設定すると他人が中継を使えない）
# SHARE_RETENTION_DAYS=30            # 共有が消えるまでの日数（画面の説明文用。実際の削除はscripts/r2_prune.py。
#                                    # GitHub Actionsのr2-prune.ymlが毎日回す。R2のライフサイクル規則は使わない）

# ---- 外部サービスの鍵（無くても動く）----
# SPOTIFY_CLIENT_ID=                 # Spotifyの公式Web API。無いとoEmbedに落ち、曲名とジャケット300pxだけになる
# SPOTIFY_CLIENT_SECRET=             # （アーティスト名は返らない。プレイリストもまとめて取れない）
# YOUTUBE_API_KEY=                   # YouTube Data API v3。無いと再生リストをまとめて取れない（単体の動画はoEmbedなので不要）
# SEARCHCACHE_SECRET=                # 検索結果の控え（R2のsearchcache/）の名前を作る鍵。未設定ならR2の鍵からderiveする
# GEMINI_API_KEY=                    # scripts/proofread.py（文章の添削）でだけ使う

# 変数の全部の一覧と既定値はdocs/env.mdを参照

# Google Search Consoleの所有権確認（HTMLタグ方式のcontent値）。公開サイトだけ。未設定ならタグは出ない
GOOGLE_SITE_VERIFICATION=

# --- 定期点検（scripts/render_check.py、.github/workflows/render-check.yml）---
# RENDER_API_KEY=rnd_xxx             # Render → Account Settings → API Keys。GitHub ActionsではSecretsのRENDER_API_KEYを使う
# RENDER_SERVICE_NAME=trackmento     # 点検するサービス名（既定trackmento）
# CHECK_BW_GB_PER_HOUR=1.0           # 異常判定: 1時間の転送量（GB）。ほかCHECK_RSS_MB(400) / CHECK_MEMORY_GB(0.45) / CHECK_5XX_TOTAL(20) / CHECK_5XX_SHARE(5) / CHECK_ERRORS(10) / CHECK_LAG_LINES(5: 2秒以上のlag行数)
