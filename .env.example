# Discogs パーソナルトークン（任意。未設定ならソース選択肢から非表示）
# 取得: https://www.discogs.com/settings/developers → 「Generate new token」→ 下に貼ってサーバー再起動
DISCOGS_TOKEN=

# MusicBrainz は User-Agent 必須（連絡先を含めること）
MB_USER_AGENT=musicgrid-local/0.1 (your-email@example.com)

# 生成 PNG の URL に使うベース。LAN 内の IP を指定（スマホから開くため）
# auto にすると起動時に LAN IP を自動検出する。例: http://192.168.1.10:8000
PUBLIC_BASE_URL=auto

# outputs/ に残す世代数
OUTPUTS_KEEP=50

# ---- 公開運用（Render などにバックエンドを置くとき。ローカルでは未設定でよい）----
# PUBLIC_MODE=1                      # CORS を開き、グリッドをブラウザごとに分け、ディスクを自動で掃除
# CORS_ORIGINS=https://you.github.io # フロントのオリジン（カンマ区切り）
# FRONTEND_URL=https://you.github.io/musicgrid-local   # 共有ページの「TRACKMENTO で開く」の戻り先
# RATE_LIMIT=120                     # API の IP ごと 1 分あたり上限
# TRUST_PROXY=1                      # Render などプロキシの後ろにいるとき（CF-Connecting-IP、無ければ X-Forwarded-For の先頭を IP とみなす）
# ---- 共有 PNG を Cloudflare R2 に置く（4 つ揃うと有効。無ければ shares/ に保存）----
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=trackmento-shares
# R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev   # バケットの公開 URL（あれば PNG を直接配信）
# MAX_CELLS=64                       # 公開時の 1 枚あたりのマス数上限（既定 64 = 8×8）
# MAX_SIDE=4000                      # 書き出し PNG の最大辺（公開時の既定 4000、ローカル 8000）
# SHARE_BUDGET_GB=9.5                # 共有ファイル（PNG+JSON）の合計上限。実バイト数で判定。R2 無料枠 10GB の手前
# SHARE_LIMIT_PER_IP_DAY=20          # 共有の回数上限（IP ごと・1 日）。公開時の既定 20
# SHARE_LIMIT_PER_DAY=200            # 共有の回数上限（サーバー全体・1 日）。公開時の既定 200

# Google Search Console の所有権確認（HTML タグ方式の content 値）。公開サイトだけ。未設定ならタグは出ない
GOOGLE_SITE_VERIFICATION=
