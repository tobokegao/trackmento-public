{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.bak*)",
      "Read(./**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/block_env.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
